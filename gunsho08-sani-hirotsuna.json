 "poems": [
  {
   "seq": "1",
   "text": "子日する松の葉とにかそふれは猶そつきせぬ君か干とせは",
   "kana": "",
   "speaker": "",
   "page": 42,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "2",
   "text": "遙かなる君か齡にくらへんと子日松をけふはひくかな",
   "kana": "",
   "speaker": "",
   "page": 42,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "鶯のこゑを友にてくらすかなひとりなかむる春の山里",
   "kana": "",
   "speaker": "",
   "page": 42,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "山家は鳴うくひすの聲のみそのとけき春の友と聞ゆる",
   "kana": "",
   "speaker": "",
   "page": 42,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "ゆく風の雲のはやしに鳴蟬はこゑもともにそ高く聞ゆる",
   "kana": "",
   "speaker": "",
   "page": 43,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "おほつかな隣もみえす也にけり霞へたつるむら雲の里",
   "kana": "",
   "speaker": "",
   "page": 43,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "夏木たちしけき梢に鳴蟬の聲きくからにあつくも有かな",
   "kana": "",
   "speaker": "",
   "page": 43,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "春かすみ八重たちぬれはたつねゆく道も忘れすくらはしの里",
   "kana": "",
   "speaker": "",
   "page": 43,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "八重むくらしける軒はをかきわけて星合の空を眺めつる哉",
   "kana": "",
   "speaker": "",
   "page": 43,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "なつかしきかこそ袖まて匂ふなれ花の梢ははるかなれとも",
   "kana": "",
   "speaker": "",
   "page": 43,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "七夕のあふよのほとは思ひやる心さへこそ空にすみけれ",
   "kana": "",
   "speaker": "",
   "page": 43,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "12",
   "text": "花さかり咲そめしよりあかなくによその梢を折つゝそ見る",
   "kana": "",
   "speaker": "",
   "page": 43,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "13",
   "text": "尋ねくるかひもあるかな草むらに我まつ虫の聲そきこゆる",
   "kana": "",
   "speaker": "",
   "page": 43,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "14",
   "text": "あさみとりむら〓〓みえし若草の夏とゝもにも深く也ける",
   "kana": "",
   "speaker": "",
   "page": 43,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "15",
   "text": "松虫のこゑも絕せぬくさむらはたつれぬ人も尋ねきにけり",
   "kana": "",
   "speaker": "",
   "page": 43,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "16",
   "text": "夏草はにはつさなとみしかと鹿ふすはかり也もゆくかな",
   "kana": "",
   "speaker": "",
   "page": 43,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "17",
   "text": "宮城のやたつねてきつる藤はかましるくも匂ふ夕まくれ哉",
   "kana": "",
   "speaker": "",
   "page": 43,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "18",
   "text": "さためなく吹風なれは池水の岸をめくりてよする藤浪",
   "kana": "",
   "speaker": "",
   "page": 43,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "19",
   "text": "今よりはいそきもゆかし入日さす野山の花そ匂ひましける",
   "kana": "",
   "speaker": "",
   "page": 43,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "20",
   "text": "藤浪のかゝらぬ岸のなけれはやこきくる舟のよるひまもなき",
   "kana": "",
   "speaker": "",
   "page": 43,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "21",
   "text": "白露のそむる紅葉のいかなれはから紅にふかくみゆらん",
   "kana": "",
   "speaker": "",
   "page": 43,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "22",
   "text": "白妙にうの花さける垣ねをはつもりし雪と思ひけるかな",
   "kana": "",
   "speaker": "",
   "page": 43,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "23",
   "text": "いかに置しら露なれは紅葉はの紅ふかく色をそむらん",
   "kana": "",
   "speaker": "",
   "page": 43,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "24",
   "text": "み渡はたねの野へのうつき原みな白妙に咲きにけるかな",
   "kana": "",
   "speaker": "",
   "page": 43,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "25",
   "text": "をく霜に籬のきくをみわたせは色々にこそうつろひにけれ",
   "kana": "",
   "speaker": "",
   "page": 43,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "26",
   "text": "をく霜に籬の菊をみわたせは色々にこそうつろひにけれ(マこ)",
   "kana": "",
   "speaker": "",
   "page": 43,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "27",
   "text": "かゝみ山曉かたにみわたせはあまきりあひて初雪そふる",
   "kana": "",
   "speaker": "",
   "page": 43,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "28",
   "text": "朝ほらけまたふみわけぬ初雪に何れをみちとわきそかねつる",
   "kana": "",
   "speaker": "",
   "page": 43,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "29",
   "text": "我妹兒かうつから衣さよ更てほのかに聞ゆいつこ成らん",
   "kana": "",
   "speaker": "",
   "page": 43,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "30",
   "text": "手もたゆく成もゆくらんさよふかみ衣して打さとののとけさ",
   "kana": "",
   "speaker": "",
   "page": 43,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "31",
   "text": "庭の面に人に馴たるあしたつは齡を君にゆづる成べし",
   "kana": "",
   "speaker": "",
   "page": 43,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "32",
   "text": "千とせふるやとの景色やしるからん汀のたつの馴にける哉",
   "kana": "",
   "speaker": "",
   "page": 43,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  }
 ],
